# Copy to .env.local for local development; set the same variables in your host's dashboard.

# Public address of the live site, used for social-share images, the sitemap and robots.txt.
# On Vercel it falls back to the project's production domain when left unset.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Only for the data scripts in scripts/ (poster and logo fetching). The site never reads it:
# don't add it to the host.
# TMDB_API_KEY=
